{
  // Static-asset Worker: there is no server code, only the built SPA.
  //
  // `single-page-application` is load-bearing. The dashboard routes on
  // `window.location.pathname`, so a developer opening /cli/authorize directly —
  // which is exactly how the CLI opens it — must be served index.html rather
  // than a 404.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "riabuild-web",
  // The account that owns the clubria.com zone, so the Worker and its DNS
  // record live together.
  "account_id": "185f8d1747f1e766b83b40ddebdbfafa",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
}
