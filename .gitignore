# Rust. Per-worktree: each checkout builds its own finished binaries here.
target/

# The one compiled dependency graph every checkout and worktree shares. Written
# at the main checkout root only, because that is where the cargo config that
# names it lives. See riabuild-cli/CLAUDE.md.
/shared-build/

# Machine-local cargo config, which is what points them all at that one
# shared-build/. It must stay untracked: a tracked config is copied into every
# worktree by git, cargo then reads the worktree's own copy, and each worktree
# resolves the relative build-dir against itself — handing back the private
# dependency graphs it exists to prevent. See riabuild-cli/CLAUDE.md.
/.cargo/

# Secrets — never commit
.env
.env.*
!.env.example

# OS
.DS_Store

# e2e/remote/run.sh writes this from a freshly generated key each run —
# never a real credential, but never something to commit either.
e2e/remote/authorized_keys
# Written by e2e/run.sh when a run fails, and uploaded as a CI artifact.
e2e-logs/
